# -----------------------------------------------------------------------------
# Variables du backend ÉCHELLE EG39.
#
# Copier en `.env` pour le développement local. En production, ces valeurs sont
# saisies dans le tableau de bord Render (voir render.yaml) et ne doivent
# jamais être commitées.
# -----------------------------------------------------------------------------

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/echelle_eg39

# ── Jetons ───────────────────────────────────────────────────────────────────
# Signature des JWT. 32 caractères minimum.
# Génération : openssl rand -hex 32
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origines navigateur autorisées, séparées par des virgules.
# Obligatoire en production : sans valeur, aucune origine navigateur n'est
# acceptée. Les applications mobiles Flutter ne sont pas concernées.
ALLOWED_ORIGINS=http://localhost:3000

# ── Compte administrateur ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@echelle-eg39.com
# Obligatoire à la première création du compte. Aucune valeur par défaut
# n'existe : 16 caractères minimum, lettres et chiffres, valeur unique.
# Rotation d'un compte existant : npm run admin:password
ADMIN_PASSWORD=
ADMIN_PHONE=+22890014329

# ── Messagerie (SendGrid) ────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=admin@echelle-eg39.com
SUPPORT_EMAIL=admin@echelle-eg39.com

# ── SMS (Africa's Talking) ───────────────────────────────────────────────────
AT_API_KEY=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ── Images (Cloudinary) ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Page /tester (facultatif) ────────────────────────────────────────────────
# Sans valeur, la page utilise les URL d'APK écrites dans
# src/routes/public_pages.js.
ANDROID_TEST_APK_URL=
ANDROID_TEST_APK_ARM64_URL=
