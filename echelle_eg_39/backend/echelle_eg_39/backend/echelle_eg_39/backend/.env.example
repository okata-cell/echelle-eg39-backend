# ============================================
# CONFIGURATION - SENDGRID (Emails gratuits)
# ============================================

# Obtenez votre clé API gratuite sur: https://sendgrid.com
# 1. Créez un compte SendGrid
# 2. Allez dans Settings > API Keys
# 3. Créez une clé API (Full Access)
# 4. Copiez la clé ci-dessous

SENDGRID_API_KEY=VOTRE_API_KEY_ICI

# ============================================
# CONFIGURATION - AFRICA'S TALKING (SMS)
# ============================================

# Optionnel - Pour les SMS (gratuit pour l'Afrique)
# https://africastalking.com

# AFRICASTALKING_API_KEY=votre_api_key
# AFRICASTALKING_USERNAME=sandbox

# ============================================
# AUTRES CONFIGURATIONS
# ============================================

# URL de votre base de données
DATABASE_URL=postgres://...

# Secret pour les tokens JWT
JWT_SECRET=echelle-eg39-secret-key-2024

