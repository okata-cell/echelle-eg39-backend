# Configuration de la base de données PostgreSQL
DATABASE_URL=postgresql://username:password@host:port/database

# Secret JWT pour les tokens d'authentification (générer une chaîne aléatoire sécurisée)
JWT_SECRET=votre_secret_jwt_ultra_securise_minimum_32_caracteres

# Port du serveur (optionnel, par défaut 3000)
PORT=3000

# Environnement (production ou development)
NODE_ENV=production

# Informations admin par défaut (optionnel)
ADMIN_EMAIL=admin@echelle-eg39.com
ADMIN_PASSWORD=Admin123!
ADMIN_PHONE=+22890014329
